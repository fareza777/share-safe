    <string name="home_media_disclosure_title">Gallery access</string>
    <string name="home_media_disclosure_body">ShareSafe asks for photo access only to list your newest screenshots on the home screen. Images are read on this device, redacted on this device, and never uploaded. Gallery access is optional — the system photo picker works without it.</string>
    <string name="home_media_disclosure_accept">Allow gallery access</string>
    <string name="home_media_disclosure_skip">Skip, use the picker</string>
    <string name="home_privacy_title">Where your pixels go</string>
    <string name="home_privacy_local">Every scan and redaction runs on this device with bundled, offline models.</string>
    <string name="home_privacy_scan_title">On-device only</string>
    <string name="home_privacy_offline_title">Nothing is uploaded</string>
    <string name="home_privacy_offline_body">No account, no sync, no analytics. There is no code path that sends an image anywhere.</string>
    <string name="home_privacy_export_title">Baked-in redaction</string>
    <string name="home_privacy_export">Redaction is baked into the exported pixels, not a layer on top.</string>
    <string name="home_privacy_ads_title">What the ads see</string>
    <string name="home_privacy_ads_body">A banner on the app’s own screens keeps ShareSafe free. An ad request carries the format it asked for and nothing else — never an image, a file name or a single detection result.</string>

    <!-- Onboarding -->
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_start">Start redacting</string>
    <string name="onboarding_page_scan_title">It reads the screenshot for you</string>
    <string name="onboarding_page_scan_body">Phone numbers, emails, cards, IDs, plates, network addresses, one-time codes, QR codes and faces are found the moment an image opens — offline, on this device.</string>
    <string name="onboarding_page_redact_title">One tap hides all of it</string>
    <string name="onboarding_page_redact_body">Pick a screenshot and the app does the rest: every detection is hidden before you see the preview. Blur, pixelate, black out or tint — and the editor is still there if you want to change something by hand.</string>
    <string name="onboarding_page_verify_title">Verified before it leaves</string>
    <string name="onboarding_page_verify_body">Every export is scanned again, and anything still readable is hidden and re-verified automatically before you share.</string>
    <string name="onboarding_page_offline_title">Nothing ever leaves the phone</string>
    <string name="onboarding_page_offline_body">The scan, the redaction and the verification never touch the network. The one thing that goes online is the ad slot, which is never given your image or anything the scan found.</string>

