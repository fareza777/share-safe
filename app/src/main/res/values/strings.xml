    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_rate">Rate</string>
    <string name="about_share_app">Share app</string>
    <string name="about_share_title">Share ShareSafe</string>
    <string name="about_share_body">%1$s — redact screenshots before you send them, entirely on device. %2$s</string>
    <string name="about_privacy_title">What this app can and cannot do</string>
    <string name="about_no_internet_body">Screenshots never leave the phone. Scanning, redaction and verification are on-device code with bundled models, and there is no upload path anywhere in the app. The only traffic is the ads SDK asking for an ad; it is never handed an image, a file name or a scan result. A device test asserts exactly which network permissions exist.</string>
    <string name="about_verify_body">Every export is scanned again — text, codes and faces — and automatically repaired if anything is still readable.</string>
    <string name="about_storage_title">What stays on disk</string>
    <string name="about_storage_body">Only redacted copies and their metadata: %1$d KB right now. The original screenshots are never copied, and clearing History deletes everything.</string>
    <string name="about_how_title">How the automatic flow works</string>
    <string name="about_auto_title">Automatic by default</string>
    <string name="about_auto_body">Picking an image scans it, every hit starts enabled, and the export is verified and repaired without any tap. The editor is there to take things back, not to make you do work.</string>
    <string name="about_engine_title">Detection engine</string>
    <string name="about_engine_body">On-device OCR plus pattern heuristics (phones, emails, cards with Luhn checks, ID/NPWP/passport, accounts and IBAN, one-time codes, tokens, coordinates, network addresses, plates), barcode payload classification (QRIS payments, 2FA secrets, WiFi, contacts, payment and social links) and face detection.</string>
    <string name="about_more_title">More</string>
    <string name="about_licenses">Open-source licences</string>
    <string name="about_licenses_body">ShareSafe is built on Kotlin, Jetpack Compose and Material 3 (Apache License 2.0), on Google ML Kit on-device text recognition, barcode scanning and face detection (Google ML Kit terms), and on Google Mobile Ads for the banner, interstitial and rewarded formats (Google Mobile Ads terms). No analytics and no crash reporting are included, and the telemetry library that ML Kit drags in is never given anything to send.</string>
    <string name="about_replay_onboarding">Show the intro again</string>
    <string name="about_replay_body">The intro will appear at the next launch, with your settings untouched.</string>
    <string name="about_footer">Made to keep screenshots boring. No account, no upload, and no ad ever sees your image.</string>

